<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.HistoryDetailController"
            styleClass="app-root" prefWidth="1000.0" prefHeight="680.0"
            stylesheets="@style.css, @ranking.css">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <!-- onLogout trong controller thực chất là "quay lại danh sách lịch sử" -->
                <Button styleClass="btn-ghost" text="← Quay lại" onAction="#onLogout"/>
                <Label styleClass="brand" text="Lật Bài Online"/>
                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="16.0">
            <BorderPane.margin><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></BorderPane.margin>
            <children>
                <Label fx:id="lblPlayerName" styleClass="page-title" text="Người chơi"/>

                <HBox spacing="12.0">
                    <children>
                        <VBox styleClass="stat-card" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="TỔNG TRẬN"/>
                                <Label fx:id="lblTotalMatches" styleClass="stat-value" text="0"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card, stat-win" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="THẮNG"/>
                                <Label fx:id="lblWins" styleClass="stat-value" text="0"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card, stat-lose" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="THUA"/>
                                <Label fx:id="lblLosses" styleClass="stat-value" text="0"/>
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card, stat-draw" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="HÒA"/>
                                <Label fx:id="lblDraws" styleClass="stat-value" text="0"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <TableView fx:id="tblDetailHistory" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMatchId" text="TRẬN" prefWidth="55.0" minWidth="55.0"/>
                        <TableColumn fx:id="colDate" text="NGÀY" prefWidth="110.0" minWidth="110.0"/>
                        <TableColumn fx:id="colOpponent" text="ĐỐI THỦ" prefWidth="110.0" minWidth="110.0"/>
                        <TableColumn fx:id="colResult" text="KẾT QUẢ" prefWidth="80.0" minWidth="80.0"/>
                        <TableColumn fx:id="colPoints" text="SỐ CẶP" prefWidth="70.0" minWidth="70.0"/>
                        <TableColumn fx:id="colStartTime" text="BẮT ĐẦU" prefWidth="90.0" minWidth="90.0"/>
                        <TableColumn fx:id="colEndTime" text="KẾT THÚC" prefWidth="90.0" minWidth="90.0"/>
                        <TableColumn fx:id="colDuration" text="THỜI LƯỢNG" prefWidth="110.0" minWidth="110.0"/>
                        <TableColumn fx:id="colIsQuit" text="THOÁT" prefWidth="70.0" minWidth="70.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label styleClass="muted" text="Người chơi này chưa đấu trận nào."/>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
