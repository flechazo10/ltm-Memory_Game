<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Màn chơi. Ảnh nền theo chủ đề được GameRoomController gắn vào AnchorPane "background"
  (đường dẫn ảnh: xem THEME_BACKGROUNDS trong GameRoomController và src/assets/README.md).
-->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controller.GameRoomController"
           prefWidth="1100.0" prefHeight="720.0"
           stylesheets="@style.css">
    <children>
        <AnchorPane fx:id="background" styleClass="game-bg">
            <children>
                <VBox fx:id="rootPane" spacing="16.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <padding><Insets top="16.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                    <children>

                        <!-- Thanh trên: rời trận | đồng hồ trận 15 phút | nhạc -->
                        <HBox styleClass="game-topbar" alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button fx:id="btnHome" text="← Rời trận" onAction="#onHomeButton"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label styleClass="player-role" text="THỜI GIAN TRẬN"/>
                                        <Label fx:id="lblMatchTime" styleClass="match-time" text="15:00"/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnMusic" styleClass="btn-ghost" text="Nhạc: Bật" onAction="#onMusicButton"/>
                            </children>
                        </HBox>

                        <!-- Người chơi | bàn bài | đối thủ -->
                        <HBox alignment="TOP_CENTER" spacing="20.0" fillHeight="false" VBox.vgrow="ALWAYS">
                            <children>

                                <VBox styleClass="player-card" alignment="TOP_CENTER" spacing="6.0">
                                    <children>
                                        <Label styleClass="player-role" text="BẠN"/>
                                        <Label fx:id="txtPlayer1" styleClass="player-name" text="Người chơi"/>
                                        <Label fx:id="txtScore1" styleClass="muted" text="Số cặp đã ăn">
                                            <VBox.margin><Insets top="14.0"/></VBox.margin>
                                        </Label>
                                        <StackPane>
                                            <children>
                                                <Label fx:id="txtScore1Value" styleClass="score-value" text="0"/>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <VBox styleClass="board-panel" alignment="TOP_CENTER" spacing="12.0">
                                    <children>
                                        <Label fx:id="lblTurnIndicator" styleClass="turn-indicator" text="CHUẨN BỊ..."/>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <ProgressBar fx:id="timeBar" prefWidth="460.0" prefHeight="10.0" progress="1.0"/>
                                                <Label fx:id="timeLabel" styleClass="time-label" text="15s"/>
                                            </children>
                                        </HBox>
                                        <GridPane fx:id="tblCard" alignment="CENTER" hgap="10.0" vgap="10.0"
                                                  minWidth="590.0" minHeight="390.0"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="player-card" alignment="TOP_CENTER" spacing="6.0">
                                    <children>
                                        <Label styleClass="player-role" text="ĐỐI THỦ"/>
                                        <Label fx:id="txtPlayer2" styleClass="player-name" text="Đối thủ"/>
                                        <Label fx:id="txtScore2" styleClass="muted" text="Số cặp đã ăn">
                                            <VBox.margin><Insets top="14.0"/></VBox.margin>
                                        </Label>
                                        <StackPane>
                                            <children>
                                                <Label fx:id="txtScore2Value" styleClass="score-value" text="0"/>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Lớp phủ đếm ngược 3-2-1 trước trận -->
        <Pane fx:id="overlayBackground" styleClass="countdown-dim" visible="false"/>
        <StackPane fx:id="countdownOverlay" visible="false" mouseTransparent="true">
            <children>
                <Label fx:id="countdownLabel" text="3"/>
            </children>
        </StackPane>
    </children>
</StackPane>
