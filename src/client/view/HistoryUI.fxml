<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.HistoryController"
            styleClass="app-root" prefWidth="1000.0" prefHeight="680.0"
            stylesheets="@style.css, @ranking.css">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Button text="← Về sảnh" onAction="#onBack"/>
                <Label styleClass="brand" text="Lật Bài Online"/>
                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0">
            <BorderPane.margin><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></BorderPane.margin>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblWelcome" styleClass="page-title" text="Lịch sử đấu"/>
                                <Label styleClass="muted" text="Chọn một người chơi để xem chi tiết từng trận."/>
                            </children>
                        </VBox>
                        <Button styleClass="btn-primary" text="Xem chi tiết" onAction="#onDetailHistory"/>
                    </children>
                </HBox>
                <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNameH" text="NGƯỜI CHƠI" prefWidth="380.0"/>
                        <TableColumn fx:id="colTotalScoreH" text="TỔNG ĐIỂM" prefWidth="180.0"/>
                        <TableColumn fx:id="colStatusH" text="TRẠNG THÁI" prefWidth="180.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label styleClass="muted" text="Chưa có người chơi nào."/>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
