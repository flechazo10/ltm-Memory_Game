<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.MainController"
            styleClass="app-root" prefWidth="1000.0" prefHeight="680.0"
            stylesheets="@style.css, @main.css">

    <!-- Thanh trên cùng -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Button text="☰ Menu" onAction="#onBackToMenu"/>
                <Label styleClass="brand" text="Lật Bài Online"/>
                <Label fx:id="lblSelection" styleClass="welcome-chip" text="Chủ đề · Độ khó"/>
                <Button styleClass="btn-neutral, btn-small" text="Đổi chủ đề" onAction="#onChangeTheme"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblWelcome" styleClass="welcome-chip" text="Xin chào"/>
                <Button fx:id="btnMusic" styleClass="btn-yellow" text="Nhạc: Bật" onAction="#onMusic"/>
            </children>
        </HBox>
    </top>

    <!-- Danh sách người chơi -->
    <center>
        <VBox spacing="12.0">
            <BorderPane.margin><Insets top="24.0" right="12.0" bottom="24.0" left="24.0"/></BorderPane.margin>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="page-title" text="Người chơi đang online"/>
                                <Label styleClass="muted" text="Bấm Mời ở thẻ một người đang Rảnh để thách đấu."/>
                            </children>
                        </VBox>
                        <Button styleClass="btn-green" text="Làm mới" onAction="#onRefresh"/>
                    </children>
                </HBox>
                <!-- Mỗi người chơi online là 1 thẻ: avatar, tên, điểm, trạng thái, nút Mời -->
                <StackPane styleClass="players-box" VBox.vgrow="ALWAYS">
                    <children>
                        <ScrollPane fx:id="playersScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="players-scroll">
                            <content>
                                <FlowPane fx:id="playerCards" hgap="14.0" vgap="14.0">
                                    <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
                                </FlowPane>
                            </content>
                        </ScrollPane>
                        <Label fx:id="lblNoPlayers" styleClass="muted" text="Chưa có ai online. Bấm &quot;Làm mới&quot; để tải lại."/>
                    </children>
                </StackPane>
            </children>
        </VBox>
    </center>

    <!-- Cột chức năng bên phải -->
    <right>
        <VBox styleClass="side-panel" prefWidth="250.0">
            <BorderPane.margin><Insets top="24.0" right="24.0" bottom="24.0" left="12.0"/></BorderPane.margin>
            <children>
                <!-- Thông tin của chính mình (không hiện mình trong bảng người chơi nữa) -->
                <VBox styleClass="panel, me-panel" spacing="6.0">
                    <children>
                        <Label styleClass="player-role" text="CỦA TÔI"/>
                        <Label fx:id="lblMyName" styleClass="me-name" text="Tên"/>
                        <Label fx:id="lblMyScore" styleClass="me-score" text="0 điểm"/>
                        <Button styleClass="btn-yellow, btn-menu" text="Lịch sử đấu của tôi" maxWidth="Infinity" onAction="#onMyHistory">
                            <VBox.margin><Insets top="4.0"/></VBox.margin>
                        </Button>
                    </children>
                </VBox>
                <VBox styleClass="panel" spacing="10.0">
                    <children>
                        <Label styleClass="section-title" text="Menu"/>
                        <Button styleClass="btn-primary, btn-menu" text="Bảng xếp hạng" maxWidth="Infinity" onAction="#onRanking"/>
                        <Button styleClass="btn-green, btn-menu" text="Lịch sử đấu" maxWidth="Infinity" onAction="#onHistory"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </right>
</BorderPane>
