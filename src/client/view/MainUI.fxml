<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.MainController"
            styleClass="app-root" prefWidth="1000.0" prefHeight="680.0"
            stylesheets="@style.css, @main.css">

    <!-- Thanh trên cùng -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="brand" text="Lật Bài Online"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblWelcome" styleClass="welcome-chip" text="Xin chào"/>
                <Button fx:id="btnMusic" styleClass="btn-ghost" text="Nhạc: Bật" onAction="#onMusic"/>
                <Button styleClass="btn-ghost" text="Đăng xuất" onAction="#onLogout"/>
            </children>
        </HBox>
    </top>

    <!-- Danh sách người chơi -->
    <center>
        <VBox spacing="12.0">
            <BorderPane.margin><Insets top="24.0" right="12.0" bottom="24.0" left="24.0"/></BorderPane.margin>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="page-title" text="Người chơi đang online"/>
                                <Label styleClass="muted" text="Nhấn vào một người đang rảnh để gửi lời thách đấu."/>
                            </children>
                        </VBox>
                        <Button text="Làm mới" onAction="#onRefresh"/>
                    </children>
                </HBox>
                <TableView fx:id="tblPlayers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" text="NGƯỜI CHƠI" prefWidth="300.0"/>
                        <TableColumn fx:id="colScore" text="TỔNG ĐIỂM" prefWidth="150.0"/>
                        <TableColumn fx:id="colStatus" text="TRẠNG THÁI" prefWidth="150.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label styleClass="muted" text="Chưa có ai online. Bấm &quot;Làm mới&quot; để tải lại."/>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Cột chức năng bên phải -->
    <right>
        <VBox styleClass="side-panel" prefWidth="250.0">
            <BorderPane.margin><Insets top="24.0" right="24.0" bottom="24.0" left="12.0"/></BorderPane.margin>
            <children>
                <VBox styleClass="panel" spacing="10.0">
                    <children>
                        <Label styleClass="section-title" text="Menu"/>
                        <Button styleClass="btn-primary, btn-menu" text="Bảng xếp hạng" maxWidth="Infinity" onAction="#onRanking"/>
                        <Button styleClass="btn-menu" text="Lịch sử đấu" maxWidth="Infinity" onAction="#onHistory"/>
                    </children>
                </VBox>
                <VBox styleClass="panel" spacing="8.0">
                    <children>
                        <Label styleClass="section-title" text="Luật chơi"/>
                        <Label styleClass="tip-text" text="• 24 lá (12 cặp) úp trên lưới 4×6."/>
                        <Label styleClass="tip-text" text="• Mỗi lượt có 15 giây để lật 2 lá. Trùng cặp được +1 điểm và lật tiếp."/>
                        <Label styleClass="tip-text" text="• Trận tối đa 15 phút. Thắng +1, hòa +0.5, thua 0 điểm xếp hạng."/>
                        <Label styleClass="tip-text" text="• Hết giờ 3 lượt liên tiếp hoặc thoát giữa chừng sẽ bị xử thua."/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </right>
</BorderPane>
