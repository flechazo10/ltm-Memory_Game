<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.RankingController"
            styleClass="app-root" prefWidth="1000.0" prefHeight="680.0"
            stylesheets="@style.css, @ranking.css">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Button styleClass="btn-ghost" text="← Về sảnh" onAction="#onBack"/>
                <Label styleClass="brand" text="Lật Bài Online"/>
                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0">
            <BorderPane.margin><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></BorderPane.margin>
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="page-title" text="Bảng xếp hạng"/>
                        <Label styleClass="muted" text="Xếp theo tổng điểm giảm dần. Bằng điểm thì ai thắng nhiều trận hơn đứng trên."/>
                    </children>
                </VBox>
                <TableView fx:id="tblRanking" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMedalR" text="" prefWidth="60.0" sortable="false"/>
                        <TableColumn fx:id="colRankR" text="HẠNG" prefWidth="80.0"/>
                        <TableColumn fx:id="colNameR" text="NGƯỜI CHƠI" prefWidth="320.0"/>
                        <TableColumn fx:id="colTotalScoreR" text="TỔNG ĐIỂM" prefWidth="160.0"/>
                        <TableColumn fx:id="colWinCountR" text="SỐ TRẬN THẮNG" prefWidth="160.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label styleClass="muted" text="Chưa có dữ liệu xếp hạng."/>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
